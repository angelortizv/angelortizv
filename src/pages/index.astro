---
const title = 'Angelo Ortiz Vega — Blog en pausa';
const description =
  'Este blog está en pausa. Si buscas a Angelo Ortiz Vega, mi sitio actual es angelortizv.me.';
const target = 'https://www.angelortizv.me';
const email = 'angelo@angelortizv.com';
const ogImage = new URL('/og/home', Astro.site).href;
const socials = [
  {
    name: 'GitHub',
    url: 'https://github.com/angelortizv',
    paths: ['M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22'],
  },
  {
    name: 'Instagram',
    url: 'https://www.instagram.com/angelortizv',
    paths: ['M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z', 'M17.5 6.5h.01'],
    rect: { x: 2, y: 2, width: 20, height: 20, rx: 5 },
  },
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/angelortizv',
    paths: ['M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z'],
    rect: { x: 2, y: 9, width: 4, height: 12 },
    circle: { cx: 4, cy: 4, r: 2 },
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="theme-color" content="#060010" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/Calibre-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <div class="aurora" aria-hidden="true">
      <div class="grid"><canvas id="dot-grid"></canvas></div>
    </div>

    <main>
      <div class="pills">
        <p class="pill clock" id="local-time" hidden>
          <span class="dot" aria-hidden="true"></span>
          <span id="local-time-text"></span>
        </p>
        <p class="pill">Blog en pausa</p>
      </div>

      <h1>
        <span class="blur">Angelo</span> <span class="gradient">Ortiz.</span>
      </h1>

      <p class="lead">
        Este blog está en pausa por ahora. Si estás buscando
        <strong>angelortizv.me</strong>, ahí vive mi sitio actual: proyectos, experiencia y
        contacto.
      </p>

      <div class="actions">
        <a class="btn" href={target} rel="noopener">angelortizv.me <span aria-hidden="true">→</span></a>
      </div>

      <ul class="socials" aria-label="Redes">
        {socials.map((s) => (
          <li>
            <a href={s.url} aria-label={s.name} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {s.rect && <rect {...s.rect} />}
                {s.circle && <circle {...s.circle} />}
                {s.paths.map((d) => <path d={d} />)}
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </main>

    <div class="email-side">
      <a href={`mailto:${email}`}>{email}</a>
    </div>

    <footer>© {new Date().getFullYear()} Angelo Ortiz Vega</footer>

    <script>
      import { initDotGrid } from '../scripts/dotGrid.js';

      // Live Costa Rica time, same pill as the portfolio hero (client-only on purpose)
      const clock = document.getElementById('local-time');
      const clockText = document.getElementById('local-time-text');
      const tick = () => {
        const parts = new Intl.DateTimeFormat('es-CR', {
          timeZone: 'America/Costa_Rica',
          weekday: 'short',
          hour: '2-digit',
          minute: '2-digit',
          hourCycle: 'h23',
        }).formatToParts(new Date());
        const get = (type: string) => parts.find((p) => p.type === type)?.value ?? '';
        if (clock && clockText) {
          clockText.textContent = `Cartago ${get('weekday').replace('.', '')} ${get('hour')}:${get('minute')} · UTC−6`;
          clock.hidden = false;
        }
      };
      tick();
      window.setInterval(tick, 15000);

      // Interactive dot grid; falls back to the static CSS dots without WebGL2
      const canvas = document.getElementById('dot-grid') as HTMLCanvasElement | null;
      if (canvas && initDotGrid(canvas)) {
        document.documentElement.dataset.dots = 'gl';
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Calibre';
    src: url('/fonts/Calibre-Regular.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  @font-face {
    font-family: 'Calibre';
    src: url('/fonts/Calibre-Medium.woff2') format('woff2');
    font-weight: 500;
    font-display: swap;
  }
  @font-face {
    font-family: 'Calibre';
    src: url('/fonts/Calibre-Semibold.woff2') format('woff2');
    font-weight: 600;
    font-display: swap;
  }
  @font-face {
    font-family: 'SF Mono';
    src: url('/fonts/SFMono-Regular.woff2') format('woff2');
    font-weight: 400;
    font-display: swap;
  }
  :root {
    --bg: #060010;
    --text: #9a94b8;
    --light: #bcb7d6;
    --bright: #ece9ff;
    --signal: #a78bfa;
    --soft: #c4b5fd;
    --tint: rgba(167, 139, 250, 0.14);
    --outline: rgba(167, 139, 250, 0.18);
    --glow: rgba(124, 92, 255, 0.35);
    --contrast: #ffffff;
    --aurora: 1;
    --sans: 'Calibre', 'Inter', 'San Francisco', 'SF Pro Text', -apple-system, system-ui, sans-serif;
    --mono: 'SF Mono', 'Fira Code', 'Fira Mono', 'Roboto Mono', monospace;
  }
  @media (prefers-color-scheme: light) {
    :root {
      --bg: #faf8ff;
      --text: #5a5478;
      --light: #352f55;
      --bright: #140d30;
      --signal: #6d28d9;
      --soft: #8b5cf6;
      --tint: rgba(109, 40, 217, 0.1);
      --outline: rgba(109, 40, 217, 0.18);
      --glow: rgba(109, 40, 217, 0.2);
      --contrast: #140d30;
      --aurora: 0.5;
    }
  }

  * {
    box-sizing: border-box;
  }
  html,
  body {
    margin: 0;
    min-height: 100%;
  }
  body {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 19px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  ::selection {
    background: var(--tint);
    color: var(--signal);
  }

  .aurora {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: var(--aurora);
    background:
      radial-gradient(60vmax 45vmax at 8% -5%, rgba(124, 92, 255, 0.32), transparent 70%),
      radial-gradient(55vmax 45vmax at 100% 38%, rgba(109, 77, 255, 0.2), transparent 70%),
      radial-gradient(50vmax 40vmax at 25% 108%, rgba(167, 139, 250, 0.16), transparent 70%);
  }
  .aurora::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, var(--tint) 1.5px, transparent 1.6px);
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 0%, #000 20%, transparent 75%);
  }

  main {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
    padding: 80px 25px;
  }

  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 24px;
  }
  .pill {
    margin: 0;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--tint);
    color: var(--signal);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .pill.clock {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--outline);
    color: var(--light);
    white-space: nowrap;
  }
  .pill.clock[hidden] {
    display: none;
  }
  .pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal);
    animation: dot-pulse 2s ease-in-out infinite;
  }

  h1 {
    margin: 0;
    color: var(--bright);
    font-size: clamp(56px, 9vw, 96px);
    font-weight: 200;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .gradient {
    background: linear-gradient(110deg, var(--signal) 0%, var(--soft) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .blur {
    display: inline-block;
    animation: blur-in 0.9s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  .lead {
    max-width: 540px;
    margin: 28px 0 0;
    color: var(--text);
  }
  .lead strong {
    color: var(--light);
    font-weight: 400;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 44px;
  }
  .btn {
    display: inline-block;
    padding: 1.25rem 2rem;
    border: 1px solid var(--signal);
    border-radius: 999px;
    color: var(--contrast);
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .btn:hover,
  .btn:focus-visible {
    background: var(--signal);
    color: var(--bg);
    box-shadow: 0 0 32px var(--glow);
    outline: none;
  }

  .socials {
    display: flex;
    gap: 6px;
    margin: 36px 0 0 -10px;
    padding: 0;
    list-style: none;
  }
  .socials a {
    display: block;
    padding: 10px;
    color: var(--text);
    transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .socials a:hover,
  .socials a:focus-visible {
    color: var(--signal);
    transform: translateY(-3px);
    outline: none;
  }
  .socials svg {
    display: block;
    width: 20px;
    height: 20px;
  }

  /* vertical email on the right edge, as in the portfolio */
  .email-side {
    display: none;
  }
  @media (min-width: 768px) {
    .email-side {
      display: flex;
      flex-direction: column;
      align-items: center;
      position: fixed;
      right: 40px;
      bottom: 0;
      z-index: 1;
    }
    .email-side::after {
      content: '';
      width: 1px;
      height: 90px;
      background: var(--outline);
    }
    .email-side a {
      margin: 20px auto;
      padding: 10px;
      color: var(--text);
      font-family: var(--mono);
      font-size: 11px;
      line-height: 17px;
      letter-spacing: 0.1em;
      writing-mode: vertical-rl;
      text-decoration: none;
      transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .email-side a:hover,
    .email-side a:focus-visible {
      color: var(--signal);
      transform: translateY(-3px);
      outline: none;
    }
  }

  footer {
    position: relative;
    z-index: 1;
    padding: 24px;
    text-align: center;
    color: var(--text);
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.1em;
  }

  .aurora .grid {
    position: absolute;
    inset: 0;
    -webkit-mask-image: radial-gradient(ellipse 90% 85% at 50% 30%, #000 25%, transparent 88%);
    mask-image: radial-gradient(ellipse 90% 85% at 50% 30%, #000 25%, transparent 88%);
  }
  .aurora .grid canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  html[data-dots='gl'] .aurora::after {
    display: none;
  }

  @keyframes dot-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }
  @keyframes blur-in {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blur,
    .pill .dot {
      animation: none;
    }
    .btn,
    .socials a,
    .email-side a {
      transition: none;
    }
  }
</style>
